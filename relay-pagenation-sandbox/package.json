{
  "name": "relay-pagenation-sandbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "relay-compiler --watch & vite",
    "build": "relay-compiler && vite build",
    "preview": "vite preview",
    "relay": "relay-compiler",
    "relay:watch": "relay-compiler --watch"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-relay": "^18.0.0",
    "relay-runtime": "^18.0.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-relay": "^14.1.0",
    "@types/relay-runtime": "^14.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vite-plugin-relay": "^2.1.0",
    "relay-compiler": "^18.0.0",
    "graphql": "^16.9.0"
  },
  "relay": {
    "src": "./src",
    "schema": "./schema/github.graphql",
